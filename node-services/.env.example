# --- Shared ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Verifies the key GET /realtime/token issues (Laravel's REALTIME_JWT_SECRET
# — copy the same value, don't derive it differently on each side).
REALTIME_JWT_SECRET=

# Sent as X-Internal-Secret on every call into Laravel's routes/internal.php
# (Laravel's INTERNAL_API_SECRET — copy the same value).
INTERNAL_API_SECRET=

LARAVEL_INTERNAL_BASE_URL=http://127.0.0.1:8000

# --- pricefeed/ ---
# Duplicated from Laravel's own BROKERET_WS_URL/BROKERET_API_KEY rather than
# read from Laravel's .env directly — keeps the two pipelines genuinely
# independent per project convention (see StreamBrokeretFeed's PHP
# equivalent). Only one of the PHP daemon (ticks:stream-brokeret-ui) and this
# service should be the active Redis writer at a time — see node-services/README.md.
BROKERET_WS_URL=wss://feed.brokeret.com/ws
BROKERET_API_KEY=demo
PRICEFEED_WS_PORT=8090

# Asset auto-registration (ensureAssetRegistered port) writes directly to the
# `assets` table — the one place this service touches the shared DB, and only
# that table. Point this at whatever DB Laravel is actually using; the
# codebase's local dev defaults to sqlite (DB_CONNECTION in Laravel's own
# .env) but production is MySQL-shaped (composer.json has no sqlite driver
# pinned) — confirm against Laravel's .env before deploying, this defaults to
# MySQL via mysql2.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pocketapp
DB_USERNAME=pocketapp
DB_PASSWORD=

# --- tradesocket/ ---
TRADESOCKET_PORT=8091
# How often (ms) each connected socket's underlying Laravel session is
# re-checked via POST /internal/session/verify — closes the socket if invalid.
SESSION_HEARTBEAT_INTERVAL_MS=300000
